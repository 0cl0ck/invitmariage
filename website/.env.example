# Copier ce fichier en .env.local et renseigner les valeurs du projet Supabase
# (Supabase > Project Settings > API). La clé "anon/public" est faite pour le client.
VITE_SUPABASE_URL=https://VOTRE-PROJET.supabase.co
VITE_SUPABASE_ANON_KEY=VOTRE_CLE_ANON_PUBLIC

# Fonctions serveur /api (choix des menus) : à définir dans Vercel, jamais ici.
# SUPABASE_SERVICE_ROLE_KEY=   (Supabase > Project Settings > API > service_role)
# RESEND_API_KEY=              (resend.com > API Keys)
# Optionnels (valeurs par défaut dans api/_lib) :
